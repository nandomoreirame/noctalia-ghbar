local assert = require("./support/assert")
local runner = require("./support/runner")
local modules = require("./support/modules")
local mock = require("./support/noctalia_mock")
local describe, it = runner.describe, runner.it
local N = modules.load("lib/notifications.luau")
local fixture = modules.text("tests/fixtures/notifications.json")
local decode = mock.new().noctalia.json.decode

describe("notifications", function()
	local items = N.parse(decode(fixture)).items
	it("maps the API fields to rows", function()
		assert.equal(items[1].id, "1001")
		assert.equal(items[1].repo, "octo/hello")
		assert.equal(items[1].kind, "PullRequest")
		assert.equal(items[1].reason, "review_requested")
	end)
	it("derives the pull request web url", function()
		assert.equal(items[1].url, "https://github.com/octo/hello/pull/12")
	end)
	it("derives the issue and release web urls", function()
		assert.equal(items[2].url, "https://github.com/octo/hello/issues/7")
		assert.equal(items[3].url, "https://github.com/octo/hello/releases")
	end)
	it("falls back to the inbox url for an unknown subject", function()
		assert.equal(N.webUrl("https://api.github.com/repos/octo/hello/discussions/3"), "https://github.com/notifications")
		assert.equal(N.webUrl(nil), "https://github.com/notifications")
	end)
	it("parses updated_at into epoch milliseconds", function()
		-- Correct UTC epoch for 2026-11-10T12:00:00Z (plan had +1 day drift).
		assert.equal(N.parseTime("2026-11-10T12:00:00Z"), 1794312000000)
	end)
	it("rejects a body that is not a list", function()
		assert.equal(N.parse({ message = "Bad credentials" }).ok, false)
	end)
end)
