local assert = require("./support/assert")
local runner = require("./support/runner")
local modules = require("./support/modules")
local describe, it = runner.describe, runner.it
local Gh = modules.load("lib/gh.luau")

describe("gh token", function()
	it("trims the token from stdout", function()
		local r = Gh.parseToken({ exitCode = 0, stdout = "SECRET-GH\n", stderr = "" })
		assert.equal(r.ok, true)
		assert.equal(r.token, "SECRET-GH")
	end)
	it("reports gh as missing on exit 127", function()
		local r = Gh.parseToken({ exitCode = 127, stdout = "", stderr = "gh: command not found" })
		assert.equal(r.ok, false)
		assert.equal(r.error, "no-gh")
	end)
	it("reports a logged-out gh on a non-zero exit", function()
		local r = Gh.parseToken({ exitCode = 1, stdout = "", stderr = "You are not logged in" })
		assert.equal(r.error, "logged-out")
	end)
	it("treats an empty stdout as logged out", function()
		assert.equal(Gh.parseToken({ exitCode = 0, stdout = "  \n", stderr = "" }).error, "logged-out")
	end)
	it("never echoes the token in an error", function()
		local r = Gh.parseToken({ exitCode = 1, stdout = "SECRET-GH", stderr = "SECRET-GH" })
		assert.equal(r.token, nil)
	end)
	it("exposes the argv for gh auth token", function()
		assert.equal(table.concat(Gh.TOKEN_ARGV, " "), "gh auth token")
	end)
end)
