local assert = require("./support/assert")
local runner = require("./support/runner")
local modules = require("./support/modules")
local describe, it = runner.describe, runner.it
local Poll = modules.load("lib/poll.luau")

local function item(id)
	return { id = id, title = "t" .. id }
end

describe("poll state", function()
	it("starts empty and not loaded", function()
		local s = Poll.create()
		assert.equal(#s.items, 0)
		assert.equal(s.loaded, false)
		assert.equal(s.error, nil)
	end)
	it("succeed replaces the list and clears the error", function()
		local s = Poll.fail(Poll.create(), "network", 0, 1)
		s = Poll.succeed(s, { item("1") }, 2)
		assert.equal(#s.items, 1)
		assert.equal(s.error, nil)
		assert.equal(s.loaded, true)
	end)
	it("fail keeps the last list and sets the error kind", function()
		local s = Poll.succeed(Poll.create(), { item("1") }, 1)
		s = Poll.fail(s, "auth", 401, 2)
		assert.equal(#s.items, 1)
		assert.equal(s.error.kind, "auth")
	end)
	it("maps statuses to error kinds", function()
		assert.equal(Poll.errorKind(401), "auth")
		assert.equal(Poll.errorKind(403), "forbidden")
		assert.equal(Poll.errorKind(0), "network")
		assert.equal(Poll.errorKind(500), "http")
	end)
	it("remove and restore keep the original position", function()
		local s = Poll.succeed(Poll.create(), { item("1"), item("2"), item("3") }, 1)
		local removed = Poll.remove(s, "2")
		assert.equal(#removed.state.items, 2)
		local back = Poll.restore(removed.state, removed.item, removed.index)
		assert.equal(back.items[2].id, "2")
	end)
	it("fresh returns only unseen items and stays silent on the first load", function()
		local first = Poll.fresh(Poll.create(), { item("1") })
		assert.equal(#first, 0)
		local s = Poll.succeed(Poll.create(), { item("1") }, 1)
		assert.equal(#Poll.fresh(s, { item("1"), item("2") }), 1)
	end)
end)
